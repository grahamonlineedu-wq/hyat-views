{
  "manifest_version": 3,
  "name": "Hyæt-Views Scanner",
  "version": "1.1.0",
  "description": "Heuristic phishing and URL threat checks against the Hyæt Views API.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://hyat-views.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hyæt-Views Scanner"
  }
}
